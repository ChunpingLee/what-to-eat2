{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "rootDir": "../..",
    "outDir": "dist"
  },
  "include": [
    "index.ts",
    "url-policy.ts",
    "parsers/**/*.ts",
    "../place-search/amap-client.ts",
