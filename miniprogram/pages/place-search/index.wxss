.header {
  padding: 24rpx 8rpx 32rpx;
}

.headline {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--title);
}

.subtitle {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--sub);
  line-height: 1.6;
}

.form-card {
  display: flex;
  flex-direction: column;
}

.field-label {
  font-size: 24rpx;
  color: var(--sub);
  margin: 20rpx 0 12rpx;
}

.field-label:first-child {
  margin-top: 0;
}

.cta {
  margin-top: 32rpx;
}

.cta-ghost {
  margin-top: 20rpx;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.empty-emoji {
  font-size: 80rpx;
}

.empty-title {
  margin-top: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--sub);
}

.empty-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--sub2);
}

.section-head {
  margin: 40rpx 8rpx 20rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--title);
}

.section-note {
  font-size: 22rpx;
  color: var(--sub2);
}
