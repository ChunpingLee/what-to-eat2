.page { padding: 32rpx; }
.title { font-size: 40rpx; font-weight: 700; }
.hint { margin: 20rpx 0; color: #666; font-size: 28rpx; }
.input { display: block; box-sizing: border-box; width: 100%; margin: 20rpx 0; padding: 20rpx; border: 1rpx solid #ddd; border-radius: 10rpx; }
.primary { margin-top: 20rpx; background: #07c160; color: #fff; }
.error { margin: 20rpx 0; color: #d93025; }
