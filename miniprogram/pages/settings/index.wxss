.page { min-height: 100vh; padding: 32rpx; background: #f7f8fa; color: #1f2937; }
.title { margin-bottom: 24rpx; font-size: 38rpx; font-weight: 600; }
.notice, .error { padding: 24rpx; border-radius: 16rpx; background: #fff; font-size: 26rpx; line-height: 1.7; }
.danger { margin-top: 32rpx; background: #b91c1c; color: #fff; }
.error { margin-top: 24rpx; color: #b91c1c; }
