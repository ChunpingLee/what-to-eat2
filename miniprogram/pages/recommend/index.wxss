.page { min-height: 100vh; padding: 40rpx 24rpx 80rpx; box-sizing: border-box; background: #f7f8fa; color: #1f2937; }
.title { font-size: 40rpx; font-weight: 700; }
.hint, .meta, .address { color: #6b7280; font-size: 26rpx; line-height: 1.6; }
.hint { margin-top: 12rpx; }
.section { margin-top: 28rpx; padding: 24rpx; border-radius: 20rpx; background: #fff; }
.section-title { margin: 20rpx 0 12rpx; font-size: 28rpx; font-weight: 600; }
.section-title:first-child { margin-top: 0; }
.chips { display: flex; flex-wrap: wrap; gap: 12rpx; }
.chip, .random { margin: 0; padding: 0 24rpx; min-width: 120rpx; line-height: 64rpx; border: 2rpx solid #e5e7eb; border-radius: 999rpx; background: #fff; color: #374151; font-size: 26rpx; }
.chip::after, .random::after, .card-action::after { border: 0; }
.selected { border-color: #ef4444; background: #fff1f2; color: #dc2626; }
.input, .number-input { height: 76rpx; line-height: 76rpx; padding: 0 20rpx; border: 2rpx solid #e5e7eb; border-radius: 14rpx; background: #fff; font-size: 28rpx; color: #1f2937; box-sizing: border-box; }
.random { margin-top: 16rpx; }
.row { display: flex; align-items: center; gap: 12rpx; }
.number-input { flex: 1; min-width: 0; }
.separator { color: #6b7280; }
.primary, .secondary { margin-top: 24rpx; border-radius: 14rpx; font-size: 30rpx; }
.primary { background: #ef4444; color: #fff; }
.secondary { background: #fff; color: #374151; }
.notice, .error, .empty { margin-top: 24rpx; padding: 20rpx; border-radius: 14rpx; font-size: 26rpx; line-height: 1.6; }
.notice { background: #fffbeb; color: #92400e; }
.error { background: #fef2f2; color: #b91c1c; }
.empty { background: #fff; color: #6b7280; text-align: center; }
.card { margin-top: 24rpx; padding: 28rpx; border-radius: 20rpx; background: #fff; box-shadow: 0 8rpx 30rpx rgba(15, 23, 42, .06); }
.card-title { font-size: 32rpx; font-weight: 650; }
.meta, .address { margin-top: 8rpx; }
.warning { margin-top: 10rpx; color: #b45309; font-size: 25rpx; line-height: 1.5; }
.reasons { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 18rpx; }
.reason { padding: 8rpx 14rpx; border-radius: 10rpx; background: #f3f4f6; color: #4b5563; font-size: 24rpx; }
.actions { display: flex; gap: 16rpx; margin-top: 22rpx; }
.card-action { flex: 1; margin: 0; border: 0; border-radius: 12rpx; background: #f3f4f6; color: #374151; font-size: 26rpx; }
