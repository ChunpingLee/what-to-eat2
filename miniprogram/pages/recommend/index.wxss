/* ---------- 头部 ---------- */
.header {
  padding: 24rpx 8rpx 32rpx;
}

.headline {
  font-size: 52rpx;
  font-weight: 700;
  color: var(--title);
  letter-spacing: 2rpx;
}

.subtitle {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--sub);
  line-height: 1.6;
}

/* ---------- 折叠筛选条 ---------- */
.filter-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 28rpx;
  border-radius: 999rpx;
  background: var(--card);
  box-shadow: var(--shadow);
}

.filter-bar-icon {
  font-size: 32rpx;
  line-height: 1;
}

.filter-summary {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: var(--title);
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.filter-toggle {
  flex-shrink: 0;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  background: var(--tag-bg);
  color: var(--tag-text);
  font-size: 24rpx;
  font-weight: 600;
}

/* ---------- 加载态 ---------- */
.loading-row {
  margin-top: 40rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  color: var(--sub);
  font-size: 26rpx;
  justify-content: center;
}

.loading-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--primary);
  animation: pulse 1s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { transform: scale(0.8); opacity: 0.5; }
  50% { transform: scale(1.2); opacity: 1; }
}

/* ---------- 表单卡 ---------- */
.q-card,
.filter-card {
  margin-top: 24rpx;
}

.card-label {
  font-size: 24rpx;
  color: var(--sub);
  margin: 20rpx 0 16rpx;
}

.card-label:first-child {
  margin-top: 0;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.kw-row {
  margin-top: 24rpx;
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.kw-input {
  flex: 1;
}

.dice {
  flex-shrink: 0;
  height: 88rpx;
  padding: 0 30rpx;
  border-radius: 999rpx;
  background: var(--tag-soft);
  color: var(--tag-text);
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  border: 2rpx solid transparent;
}

.dice.active {
  background: var(--tag-bg);
  border-color: var(--primary);
  color: var(--tag-text);
}

/* ---------- 筛选 ---------- */
.filter-grid {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
}

.filter-cell {
  flex: 1;
  min-width: 0;
}

.filter-divider {
  padding-bottom: 28rpx;
  color: var(--sub2);
  font-size: 26rpx;
}

.mini-input {
  height: 80rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
}

/* ---------- CTA ---------- */
.cta {
  margin-top: 36rpx;
}

.cta-ghost {
  margin-top: 20rpx;
}

/* ---------- 空态 ---------- */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.empty-emoji {
  font-size: 80rpx;
}

.empty-title {
  margin-top: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--sub);
}

.empty-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--sub2);
}

/* ---------- TOP1 ---------- */
.top1 {
  margin-top: 40rpx;
  border-radius: 32rpx;
  padding: 32rpx;
  background: linear-gradient(160deg, #FF8A50, #FF5B2E);
  box-shadow: var(--shadow-lift);
  position: relative;
  overflow: hidden;
}

.top1::after {
  content: '';
  position: absolute;
  top: -70rpx;
  right: -50rpx;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.15);
}

.top1-head {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.top1-rank {
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.24);
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.top1-cost {
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  color: #FFFFFF;
  font-size: 22rpx;
}

.top1-body {
  position: relative;
  margin-top: 28rpx;
  display: flex;
  gap: 28rpx;
}

.top1-score {
  flex-shrink: 0;
  width: 168rpx;
  height: 168rpx;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.94);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 24rpx rgba(61, 43, 34, 0.16);
}

.top1-score-num {
  font-size: 76rpx;
  font-weight: 800;
  color: var(--primary-deep);
  line-height: 1;
}

.top1-score-unit {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--sub);
}

.top1-info {
  flex: 1;
  min-width: 0;
}

.top1-photo {
  flex-shrink: 0;
  width: 152rpx;
  height: 152rpx;
  border-radius: 24rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.7);
  box-shadow: 0 8rpx 20rpx rgba(61, 43, 34, 0.18);
  background: rgba(255, 255, 255, 0.2);
}

.top1-photo-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
}

.top1-name {
  font-size: 38rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1.3;
}

.top1-meta {
  margin-top: 12rpx;
  display: inline-block;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.22);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 600;
}

.top1-address {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.9);
  font-size: 24rpx;
  line-height: 1.4;
}

/* ---------- 出行时间 ---------- */
.top1-travel,
.r-travel {
  position: relative;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.travel-chip {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: var(--tag-bg);
  color: var(--tag-text);
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.4;
}

.top1-travel-chip {
  background: rgba(255, 255, 255, 0.22);
  color: #FFFFFF;
}

/* ---------- 进度条 ---------- */
.bars {
  position: relative;
  margin-top: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.bar-row {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.bar-caption {
  display: flex;
  justify-content: space-between;
  color: rgba(255, 255, 255, 0.94);
  font-size: 22rpx;
}

.bar-value {
  font-weight: 700;
}

.bar-track {
  height: 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.28);
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #FFFFFF;
}

.bar-fill-soft {
  background: rgba(255, 255, 255, 0.7);
}

/* ---------- 理由 ---------- */
.top1-reasons {
  position: relative;
  margin-top: 28rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.reason-tag {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.2);
  color: #FFFFFF;
  font-size: 22rpx;
  line-height: 1.4;
}

.top1-warning {
  position: relative;
  margin-top: 20rpx;
  padding: 14rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.9);
  color: var(--tag-text);
  font-size: 22rpx;
  line-height: 1.5;
}

.top1-actions {
  position: relative;
  margin-top: 32rpx;
  display: flex;
  gap: 20rpx;
}

.top1-fav,
.top1-nav {
  flex: 1;
  height: 84rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
}

.top1-fav {
  background: #FFFFFF;
  color: var(--primary-deep);
  box-shadow: 0 8rpx 20rpx rgba(61, 43, 34, 0.16);
}

.top1-fav.done {
  color: var(--sub);
}

.top1-nav {
  background: rgba(255, 255, 255, 0.2);
  color: #FFFFFF;
  border: 2rpx solid rgba(255, 255, 255, 0.6);
}

/* ---------- 普通结果卡 ---------- */
.r-card {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 24rpx;
  background: var(--card);
  box-shadow: var(--shadow);
}

.r-head {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.r-rank {
  flex-shrink: 0;
  width: 52rpx;
  height: 52rpx;
  border-radius: 16rpx;
  background: var(--tag-bg);
  color: var(--tag-text);
  font-size: 26rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.r-body {
  flex: 1;
  min-width: 0;
}

.r-photo {
  flex-shrink: 0;
  width: 120rpx;
  height: 120rpx;
  border-radius: 20rpx;
  background: var(--tag-soft);
  box-shadow: 0 6rpx 16rpx rgba(224, 108, 47, 0.10);
}

.r-photo-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
}

.r-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--title);
}

.r-meta {
  margin-top: 8rpx;
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
  color: var(--sub);
  font-size: 24rpx;
}

.r-cost {
  color: var(--tag-text);
}

.r-address {
  margin-top: 6rpx;
  color: var(--sub2);
  font-size: 22rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.r-score {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.r-score-num {
  font-size: 44rpx;
  font-weight: 800;
  color: var(--primary);
  line-height: 1;
}

.r-score-unit {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--sub2);
}

.r-warning {
  margin-top: 16rpx;
  color: var(--tag-text);
  font-size: 22rpx;
  line-height: 1.5;
}

.r-actions {
  margin-top: 24rpx;
  display: flex;
  gap: 16rpx;
}

.r-fav,
.r-nav {
  flex: 1;
  height: 76rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
}

.r-fav {
  background: var(--tag-bg);
  color: var(--tag-text);
}

.r-fav.done {
  background: var(--tag-soft);
  color: var(--sub);
}

.r-nav {
  background: var(--tag-soft);
  color: var(--title);
  border: 2rpx solid var(--line);
}
