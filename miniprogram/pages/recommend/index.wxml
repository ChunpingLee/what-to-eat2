<view class="page">
  <view class="title">附近推荐</view>
  <view class="hint">按真实距离、路线时间与门店公开信息，挑出现在更合适的选择。</view>

  <view class="section">
    <view class="section-title">固定品类</view>
    <view class="chips">
      <button wx:for="{{categoryOptions}}" wx:key="value" class="chip {{item.selected ? 'selected' : ''}}" data-category="{{item.value}}" bindtap="onCategory">{{item.label}}</button>
    </view>
    <view class="section-title">任意关键词</view>
    <input class="input" placeholder="例如：潮汕牛肉火锅" value="{{keywords}}" bindinput="onKeywordInput" />
    <button class="random {{preferenceMode === 'random' ? 'selected' : ''}}" bindtap="onRandom">随便吃</button>
  </view>

  <view class="section">
    <view class="section-title">预算（人均，可选）</view>
    <view class="row">
      <input class="number-input" type="number" placeholder="最低" value="{{budgetMin}}" bindinput="onBudgetMinInput" />
      <text class="separator">至</text>
      <input class="number-input" type="number" placeholder="最高" value="{{budgetMax}}" bindinput="onBudgetMaxInput" />
    </view>

    <view class="section-title">范围</view>
    <view class="chips">
      <button wx:for="{{radiusOptions}}" wx:key="value" class="chip {{item.selected ? 'selected' : ''}}" data-radius="{{item.value}}" bindtap="onRadius">{{item.label}}</button>
    </view>

    <view class="section-title">出行方式</view>
    <view class="chips">
      <button wx:for="{{travelOptions}}" wx:key="value" class="chip {{item.selected ? 'selected' : ''}}" data-mode="{{item.value}}" bindtap="onTravelMode">{{item.label}}</button>
    </view>

    <view class="section-title">最长时间（分钟，可选）</view>
    <input class="input" type="number" placeholder="例如：30" value="{{maxMinutes}}" bindinput="onMaxMinutesInput" />
  </view>

  <button class="primary" loading="{{status === 'loading'}}" bindtap="onRecommend">用当前位置推荐</button>
  <button class="secondary" bindtap="onManualLocation">手动选择地点</button>

  <view wx:if="{{status === 'locationRequired'}}" class="notice">无法使用当前位置。你可以手动选择本次查询地点。</view>
  <view wx:if="{{status === 'error'}}" class="error">{{errorMessage}}</view>
  <view wx:if="{{errorMessage && status !== 'error'}}" class="error">{{errorMessage}}</view>
  <view wx:if="{{stale}}" class="notice">正在使用稍早更新的门店数据（{{sourceUpdatedAt}}）。</view>
  <view wx:if="{{status === 'empty'}}" class="empty">没有符合条件的餐厅。可放宽最长时间或扩大范围后，再次点击推荐。</view>

  <view wx:for="{{items}}" wx:key="poiId" class="card">
    <view class="card-title">{{item.place.name}}</view>
    <view class="meta">约 {{item.distanceMeters}} 米</view>
    <view wx:if="{{item.travelTimeUnavailable}}" class="warning">出行时间未计算，仅按距离推荐，不代表满足最长时间</view>
    <view wx:else class="meta">预计 {{item.travelMinutes}} 分钟</view>
    <view wx:if="{{item.place.address}}" class="address">{{item.place.address}}</view>
    <view class="reasons">
      <text wx:for="{{item.reasons}}" wx:for-item="reason" wx:key="*this" class="reason">{{reason}}</text>
    </view>
    <view class="actions">
      <button class="card-action" disabled="{{item.added || savingPoiId === item.place.poiId}}" loading="{{savingPoiId === item.place.poiId}}" data-poi-id="{{item.place.poiId}}" bindtap="onAddFavorite">{{item.added ? '已收藏' : '加入想吃'}}</button>
      <button class="card-action" data-latitude="{{item.place.location.latitude}}" data-longitude="{{item.place.location.longitude}}" data-name="{{item.place.name}}" data-address="{{item.place.address || ''}}" bindtap="onOpenLocation">地图导航</button>
    </view>
  </view>
</view>
