.page { padding: 32rpx; color: #202124; }
.title { margin-bottom: 12rpx; font-size: 40rpx; font-weight: 700; }
.hint { margin-bottom: 24rpx; color: #667085; line-height: 1.5; }
.input { box-sizing: border-box; width: 100%; margin-bottom: 20rpx; padding: 24rpx; border: 1rpx solid #d0d5dd; border-radius: 16rpx; background: #fff; }
.primary { margin-top: 20rpx; background: #ff6b35; color: #fff; }
.secondary { margin-top: 20rpx; background: #f2f4f7; color: #344054; }
.result { margin-top: 32rpx; }
.error { margin-top: 24rpx; color: #b42318; }
.share-input { min-height: 120rpx; width: 100%; line-height: 1.5; }
