.header {
  padding: 24rpx 8rpx 32rpx;
}

.headline {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--title);
}

.subtitle {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--sub);
  line-height: 1.6;
}

.form-card {
  display: flex;
  flex-direction: column;
}

.field-label {
  font-size: 24rpx;
  color: var(--sub);
  margin: 20rpx 0 12rpx;
}

.field-label:first-child {
  margin-top: 0;
}

.share-input {
  height: 180rpx;
  min-height: 180rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  line-height: 1.5;
  text-align: left;
}

.cta {
  margin-top: 32rpx;
}

/* ---------- 结果卡 ---------- */
.result-card {
  margin-top: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 44rpx 32rpx 32rpx;
}

.result-emoji {
  font-size: 72rpx;
}

.result-title {
  margin-top: 20rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--title);
}

.result-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--sub);
  line-height: 1.6;
  margin-bottom: 28rpx;
}

.section-head {
  margin: 40rpx 8rpx 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--title);
}
