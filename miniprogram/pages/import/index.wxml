<view class="page">
  <view class="header">
    <view class="headline">链接导入</view>
    <view class="subtitle">支持美团、大众点评和高德地图的分享链接。粘贴包含【店名】的完整分享文案效果最好。</view>
  </view>

  <view class="card form-card">
    <view class="field-label">分享文案或链接</view>
    <textarea class="input share-input" placeholder="粘贴分享文案或餐厅链接" bindinput="onUrlInput" maxlength="2000" />
    <view class="field-label">城市（可选）</view>
    <input class="input" placeholder="有助于匹配分店" bindinput="onCityInput" />
    <button class="btn-primary cta" loading="{{status === 'importing'}}" disabled="{{status === 'importing'}}" bindtap="onImport">解析链接</button>
  </view>

  <view wx:if="{{status === 'error'}}" class="error">{{errorMessage}}</view>

  <view wx:if="{{status === 'search'}}" class="card result-card">
    <view class="result-emoji">✅</view>
    <view class="result-title">已提取餐厅名称</view>
    <view class="result-sub">到搜索页确认分店。</view>
    <navigator url="{{searchUrl}}"><button class="btn-primary">搜索“{{keywords}}”</button></navigator>
  </view>

  <view wx:if="{{status === 'manual'}}" class="card result-card">
    <view class="result-emoji">📋</view>
    <view class="result-title">需要手动搜索</view>
    <view class="result-sub">美团和点评的分享页面限制了自动读取。可复制含【店名】的完整分享文案重试。</view>
    <navigator url="/pages/place-search/index"><button class="btn-ghost">前往手动搜索</button></navigator>
  </view>

  <view wx:if="{{status === 'matched'}}" class="result">
    <view class="section-head">
      <text class="section-title">选择要加入的分店</text>
    </view>
    <branch-picker items="{{branches}}" selected-poi-ids="{{selectedPoiIds}}" bind:change="onSelectionChange" />
    <button class="btn-primary cta" disabled="{{selectedPoiIds.length === 0 || submitting}}" loading="{{submitting}}" bindtap="onAddSelected">加入已选分店（{{selectedPoiIds.length}}）</button>
  </view>
</view>
