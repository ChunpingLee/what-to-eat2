.page { min-height: 100vh; padding: 32rpx; background: #f7f8fa; color: #1f2937; }
.card, .hint, .error { padding: 28rpx; border-radius: 16rpx; background: #fff; }
.name { font-size: 38rpx; font-weight: 600; }
.address, .meta { margin-top: 12rpx; color: #6b7280; font-size: 26rpx; }
.primary { margin-top: 24rpx; background: #1f7ae0; color: #fff; }
.secondary { margin-top: 16rpx; background: #fff; color: #1f7ae0; }
.error { color: #b91c1c; }
