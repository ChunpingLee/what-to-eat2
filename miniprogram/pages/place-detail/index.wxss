.loading-row {
  margin-top: 80rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  color: var(--sub);
  font-size: 26rpx;
  justify-content: center;
}

.loading-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--primary);
  animation: pulse 1s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { transform: scale(0.8); opacity: 0.5; }
  50% { transform: scale(1.2); opacity: 1; }
}

.detail {
  margin-top: 8rpx;
}

/* ---------- 照片轮播 ---------- */
.photos {
  height: 380rpx;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: var(--shadow);
}

.photo {
  width: 100%;
  height: 100%;
}

/* ---------- 主卡 ---------- */
.hero {
  margin-top: 24rpx;
  border-radius: 32rpx;
  padding: 40rpx 36rpx;
  background: linear-gradient(150deg, #FF8A50, #FF5B2E);
  box-shadow: var(--shadow-lift);
  position: relative;
  overflow: hidden;
}

.hero::before {
  content: '';
  position: absolute;
  top: -80rpx;
  right: -60rpx;
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.16);
}

.hero-tag {
  display: inline-block;
  margin-bottom: 20rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.24);
  color: #FFFFFF;
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.hero-name {
  position: relative;
  font-size: 46rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1.3;
}

.hero-address {
  position: relative;
  margin-top: 16rpx;
  color: rgba(255, 255, 255, 0.92);
  font-size: 26rpx;
  line-height: 1.5;
}

.hero-area {
  position: relative;
  margin-top: 20rpx;
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.22);
  color: #FFFFFF;
  font-size: 24rpx;
}

/* ---------- 评分/人均/营业状态 ---------- */
.facts {
  margin-top: 24rpx;
  display: flex;
  gap: 20rpx;
}

.fact {
  flex: 1;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  background: var(--card);
  box-shadow: var(--shadow);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.fact-num {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--title);
}

.fact-star .fact-num {
  color: var(--primary);
}

.fact-unit {
  font-size: 22rpx;
  color: var(--sub2);
}

.fact-status .fact-num {
  font-size: 26rpx;
  color: #1E8E5A;
}

/* ---------- 品类标签 ---------- */
.cats {
  margin-top: 24rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.cat {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: var(--tag-bg);
  color: var(--tag-text);
  font-size: 24rpx;
}

/* ---------- 操作 ---------- */
.actions {
  margin-top: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.share-btn {
  height: 88rpx;
  border-radius: 999rpx;
  background: var(--tag-soft);
  color: var(--tag-text);
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #F3C9A8;
}
