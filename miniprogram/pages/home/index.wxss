.page { min-height: 100vh; padding: 24rpx; background: #f7f8fa; color: #1f2937; }
.location-notice, .hint, .error, .location-required { margin-bottom: 24rpx; padding: 20rpx; border-radius: 16rpx; background: #fff; font-size: 26rpx; }
.radius-row { display: flex; gap: 12rpx; margin-bottom: 24rpx; }
.radius-button { flex: 1; padding: 12rpx 4rpx; font-size: 24rpx; background: #fff; }
.radius-button.active { background: #1f7ae0; color: #fff; }
.favorite-card { margin-bottom: 16rpx; padding: 24rpx; border-radius: 16rpx; background: #fff; }
.name { font-size: 32rpx; font-weight: 600; }
.address, .distance { margin-top: 8rpx; color: #6b7280; font-size: 24rpx; }
.recommend-button { margin-top: 24rpx; background: #f97316; color: #fff; }
.secondary { margin-top: 16rpx; background: #fff; color: #1f7ae0; }
.error { color: #b91c1c; }
