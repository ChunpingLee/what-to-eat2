<view class="dock">
  <view class="dock-inner">
    <view class="tab {{selected === 0 ? 'on' : ''}}" data-index="0" bindtap="onTap">
      <view class="tab-icon">🏠</view>
      <view class="tab-text">想吃</view>
    </view>
    <view class="tab tab-center {{selected === 1 ? 'on' : ''}}" data-index="1" bindtap="onTap">
      <view class="fab">🎲</view>
      <view class="tab-text {{selected === 1 ? 'text-on' : ''}}">帮你挑</view>
    </view>
    <view class="tab {{selected === 2 ? 'on' : ''}}" data-index="2" bindtap="onTap">
      <view class="tab-icon">👤</view>
      <view class="tab-text">我的</view>
    </view>
  </view>
</view>
