<view class="branch-picker" aria-label="选择分店">
  <button wx:for="{{items}}" wx:key="poiId" class="branch {{item.status === 'created' || item.status === 'existing' ? 'disabled' : ''}}" data-poi-id="{{item.poiId}}" disabled="{{item.status === 'created' || item.status === 'existing'}}" bindtap="onToggle">
    <view class="branch-main">
      <text class="branch-name">{{item.name}}</text>
      <text wx:if="{{item.status === 'created' || item.status === 'existing'}}" class="added">已加入</text>
      <text wx:elif="{{selectedPoiIds.indexOf(item.poiId) !== -1}}" class="selected">已选择</text>
    </view>
    <view class="branch-address">{{item.address || ''}}</view>
    <view wx:if="{{item.businessArea}}" class="branch-area">{{item.businessArea}}</view>
    <view class="branch-distance">{{item.distanceMeters}} 米</view>
    <view wx:if="{{item.status === 'failed'}}" class="branch-failed">加入失败：{{item.failureCode || '请重试'}}</view>
  </button>
</view>
